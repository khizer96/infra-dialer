{
  "expo": {
    "name": "Infra Dialer",
    "slug": "infradialer",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "infradialer",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.infradialer.app"
    },
    "android": {
      "package": "com.infradialer.app",
      "versionCode": 4,
      "permissions": [
        "INTERNET",
        "FOREGROUND_SERVICE",
        "BIND_VPN_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "react-native-wireguard-vpn"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

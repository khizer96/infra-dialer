+package com.wireguardvpn
+
+import android.content.Context
+import org.json.JSONObject
+import java.io.BufferedReader
+import java.io.BufferedWriter
+import java.io.InputStreamReader
+import java.io.OutputStreamWriter
+import java.net.InetSocketAddress
+import java.net.Socket
+import java.util.concurrent.Executors
+import java.util.concurrent.ScheduledFuture
+
+data class TrackerBlockerStatus(
+    val enabled: Boolean,
+    val socketConnected: Boolean,
+    val counter: Int?,
+    val error: String?
+)
+
+/**
+ * Owns the tracker-blocker TCP session outside the React module lifecycle.
+ * The native executor keeps polling while the Android process is retained by
+ * the active WireGuard VPN service, even when the React Native UI is destroyed.
+ */
+object TrackerBlockerClient {
+    private const val HOST = "172.30.0.5"
+    private const val PORT = 431
+    private const val CONNECT_TIMEOUT_MS = 4_000
+    private const val READ_TIMEOUT_MS = 4_000
+    private const val POLL_INTERVAL_SECONDS = 10L
+    private const val PREFS_NAME = "wireguard_tracker_blocker"
+    private const val ENABLED_KEY = "enabled"
+
+    private val executor = Executors.newSingleThreadScheduledExecutor()
+
+    @Volatile private var socket: Socket? = null
+    @Volatile private var reader: BufferedReader? = null
+    @Volatile private var writer: BufferedWriter? = null
+    @Volatile private var counter: Int? = null
+    @Volatile private var lastError: String? = null
+    @Volatile private var listener: ((TrackerBlockerStatus) -> Unit)? = null
+    @Volatile private var listenerOwner: Any? = null
+    private var pollTask: ScheduledFuture<*>? = null
+    private var enabledAppliedToSocket = false
+
+    @Synchronized
+    fun setListener(owner: Any, nextListener: (TrackerBlockerStatus) -> Unit) {
+        listenerOwner = owner
+        listener = nextListener
+    }
+
+    @Synchronized
+    fun removeListener(owner: Any) {
+        if (listenerOwner === owner) {
+            listenerOwner = null
+            listener = null
+        }
+    }
+
+    fun getStatus(context: Context): TrackerBlockerStatus {
+        return snapshot(context)
+    }
+
+    fun ensureRunning(context: Context) {
+        if (!isEnabled(context)) return
+        startPolling(context.applicationContext)
+    }
+
+    fun enable(
+        context: Context,
+        onSuccess: (TrackerBlockerStatus) -> Unit,
+        onError: (Exception) -> Unit
+    ) {
+        val appContext = context.applicationContext
+        executor.execute {
+            try {
+                ensureConnected()
+                val response = sendCommand("set:tb:1:ad:1")
+                requireSuccess(response, "enable")
+                enabledAppliedToSocket = true
+                setEnabled(appContext, true)
+                lastError = null
+                startPolling(appContext)
+                val status = snapshot(appContext)
+                notifyStatus(appContext)
+                onSuccess(status)
+            } catch (error: Exception) {
+                lastError = error.message ?: "Could not enable tracker blocker"
+                closeSocket()
+                notifyStatus(appContext)
+                onError(error)
+            }
+        }
+    }
+
+    fun disable(
+        context: Context,
+        onSuccess: (TrackerBlockerStatus) -> Unit,
+        onError: (Exception) -> Unit
+    ) {
+        val appContext = context.applicationContext
+        executor.execute {
+            try {
+                ensureConnected()
+                val response = sendCommand("set:tb:0:ad:0")
+                requireSuccess(response, "disable")
+                sendQuit()
+                setEnabled(appContext, false)
+                counter = null
+                lastError = null
+                stopPolling()
+                closeSocket()
+                val status = snapshot(appContext)
+                notifyStatus(appContext)
+                onSuccess(status)
+            } catch (error: Exception) {
+                lastError = error.message ?: "Could not disable tracker blocker"
+                closeSocket()
+                notifyStatus(appContext)
+                onError(error)
+            }
+        }
+    }
+
+    fun stopForTunnelDisconnect(context: Context, onComplete: () -> Unit) {
+        val appContext = context.applicationContext
+        executor.execute {
+            try {
+                if (isEnabled(appContext)) {
+                    ensureReady(appContext)
+                    requireSuccess(sendCommand("set:tb:0:ad:0"), "disable")
+                    sendQuit()
+                }
+            } catch (error: Exception) {
+                lastError = error.message ?: "Could not disable tracker blocker before disconnecting"
+            } finally {
+                setEnabled(appContext, false)
+                counter = null
+                stopPolling()
+                closeSocket()
+                notifyStatus(appContext)
+                onComplete()
+            }
+        }
+    }
+
+    private fun startPolling(context: Context) {
+        if (pollTask?.isCancelled == false && pollTask?.isDone == false) return
+        pollTask = executor.scheduleWithFixedDelay({
+            if (!isEnabled(context)) return@scheduleWithFixedDelay
+            try {
+                ensureReady(context)
+                val response = sendCommand("get:stats")
+                requireSuccess(response, "read stats")
+                val body = response.optJSONObject("body")
+                    ?: throw IllegalStateException("Stats response did not contain a body")
+                if (!body.has("counter")) {
+                    throw IllegalStateException("Stats response did not contain a counter")
+                }
+                counter = body.getInt("counter")
+                lastError = null
+            } catch (error: Exception) {
+                lastError = error.message ?: "Could not refresh tracker blocker stats"
+                closeSocket()
+            }
+            notifyStatus(context)
+        }, 0, POLL_INTERVAL_SECONDS, TimeUnit.SECONDS)
+    }
+
+    private fun stopPolling() {
+        pollTask?.cancel(false)
+        pollTask = null
+    }
+
+    private fun ensureConnected() {
+        if (socket?.isConnected == true && socket?.isClosed == false) return
+        closeSocket()
+        val nextSocket = Socket()
+        nextSocket.connect(InetSocketAddress(HOST, PORT), CONNECT_TIMEOUT_MS)
+        nextSocket.soTimeout = READ_TIMEOUT_MS
+        socket = nextSocket
+        reader = BufferedReader(InputStreamReader(nextSocket.getInputStream(), Charsets.UTF_8))
+        writer = BufferedWriter(OutputStreamWriter(nextSocket.getOutputStream(), Charsets.UTF_8))
+        enabledAppliedToSocket = false
+    }
+
+    private fun ensureReady(context: Context) {
+        ensureConnected()
+        if (isEnabled(context) && !enabledAppliedToSocket) {
+            requireSuccess(sendCommand("set:tb:1:ad:1"), "restore")
+            enabledAppliedToSocket = true
+        }
+    }
+
+    private fun sendCommand(command: String): JSONObject {
+        val activeWriter = writer ?: throw IllegalStateException("Tracker blocker socket is not connected")
+        val activeReader = reader ?: throw IllegalStateException("Tracker blocker socket is not connected")
+        activeWriter.write(command)
+        activeWriter.newLine()
+        activeWriter.flush()
+
+        repeat(4) {
+            val line = activeReader.readLine()
+                ?: throw IllegalStateException("Tracker blocker socket closed before responding")
+            val trimmed = line.trim()
+            if (trimmed.startsWith("{")) {
+                return JSONObject(trimmed)
+            }
+        }
+        throw IllegalStateException("Tracker blocker returned an invalid response")
+    }
+
+    private fun sendQuit() {
+        try {
+            writer?.write("quit")
+            writer?.newLine()
+            writer?.flush()
+        } catch (_: Exception) {
+            // The blocker state was already disabled; the socket is closed below.
+        }
+    }
+
+    private fun requireSuccess(response: JSONObject, action: String) {
+        if (!response.optString("status").equals("success", ignoreCase = true)) {
+            throw IllegalStateException("Tracker blocker could not $action")
+        }
+    }
+
+    private fun closeSocket() {
+        try { reader?.close() } catch (_: Exception) {}
+        try { writer?.close() } catch (_: Exception) {}
+        try { socket?.close() } catch (_: Exception) {}
+        reader = null
+        writer = null
+        socket = null
+        enabledAppliedToSocket = false
+    }
+
+    private fun isEnabled(context: Context): Boolean {
+        return context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+            .getBoolean(ENABLED_KEY, false)
+    }
+
+    private fun setEnabled(context: Context, enabled: Boolean) {
+        context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+            .edit()
+            .putBoolean(ENABLED_KEY, enabled)
+            .apply()
+    }
+
+    private fun snapshot(context: Context): TrackerBlockerStatus {
+        return TrackerBlockerStatus(
+            enabled = isEnabled(context),
+            socketConnected = socket?.isConnected == true && socket?.isClosed == false,
+            counter = counter,
+            error = lastError
+        )
+    }
+
+    private fun notifyStatus(context: Context) {
+        listener?.invoke(snapshot(context))
+    }
+}
